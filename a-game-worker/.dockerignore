# Build context exclusions. The Dockerfile only COPYs pyproject.toml, uv.lock and
# app/, but keeping the context small speeds every build — and guards against a
# future `COPY . .` silently shipping secrets or a host-built venv.

# Secrets — never in an image layer.
.env
.env.*

# Host virtualenv: large, and built for the host platform, not the image.
.venv/
venv/

# Python build artefacts. __pycache__ would otherwise ride along in `COPY app ./app`.
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Test and type-check caches.
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# VCS and editor state.
.git/
.gitignore
.vscode/
.idea/

# Schema DDL is applied to the database directly, not run from the image.
postgres/

# Docs and local tooling.
*.md
Dockerfile
.dockerignore
